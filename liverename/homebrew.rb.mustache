# vim: set ft=ruby :
class {{formula_class}} < Formula
  desc "Watches a file with watchexec and renames it with a timestamp when it is created."
  version "{{version}}"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on "watchexec"

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "{{name}}"
    man1.install "man/{{name}}.1"
  end

  test do
    # TODO Add better tests. (Challenging with watchexec.)
    out = shell_output("#{bin}/{{name}} -v")
    assert_match version.to_s, out
  end
end
