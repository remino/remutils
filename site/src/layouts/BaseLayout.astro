---
import HeaderNav from '../components/HeaderNav.astro'
import '../assets/css/style.css'

interface Props {
	title?: string
}

const { title = 'remutils' } = Astro.props
const documentTitle = title === 'remutils' ? title : `${title} // remutils`
const breadcrumbs =
	title === 'remutils'
		? [{ label: 'remutils', href: '/remutils/' }]
		: [
				{ label: 'remutils', href: '/remutils/' },
				{ label: title },
			]
const navItems = [
	{ label: 'Home', href: '/remutils/' },
	{ label: 'Licence', href: '/remutils/licence/' },
	{ label: 'GitHub', href: 'https://github.com/remino/remutils', external: true },
]
---

<!doctype html>
<html lang="en-CA" class="no-js rmn-nav-ribbon-bg-blur">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="viewport-fit=cover, width=device-width, initial-scale=1.0" />
		<meta name="description" content="Documentation for remutils command-line tools." />
		<title>{documentTitle}</title>
		<link rel="stylesheet" href="/nav/nav.css" />
		<script type="module" src="/nav/nav.js"></script>
		<script>
			document.documentElement.classList.add('js')
			document.documentElement.classList.remove('no-js')
		</script>
	</head>
	<body>
		<header>
			<h1><a href="/remutils/">remutils</a></h1>
			<HeaderNav items={navItems} />
		</header>
		<main><slot /></main>
		<div class="rmn-nav__content">
			<ul class="rmn-breadcrumbs">
				{
					breadcrumbs.map(item => (
						<li>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
					))
				}
			</ul>
		</div>
		<remino-ribbon-nav class="rmn-nav__ribbon" key=". r" content=".rmn-nav__content" />
		<noscript><footer><small>© 2026 <a href="https://remino.net/">Rémino Rem</a></small></footer></noscript>
	</body>
</html>
