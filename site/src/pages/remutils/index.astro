---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getTools } from '../../lib/tools'

const tools = await getTools()
---

<BaseLayout>
	<h1>remutils documentation</h1>
	<p>A collection of small, independently released command-line tools.</p>
	<dl class="tool-list">
		{tools.map(tool => (
			<div>
				<dt>
					<a href={`/remutils/${tool.name}/`}><strong>{tool.name}</strong></a>
				</dt>
				{tool.description && <dd>{tool.description}</dd>}
			</div>
		))}
	</dl>
</BaseLayout>
