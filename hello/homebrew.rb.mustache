# vim: set ft=ruby :
class {{formula_class}} < Formula
  desc "Just saying hello!"
  version "{{version}}"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on "bash"

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "{{name}}"
  end

  test do
    out = shell_output("#{bin}/{{name}}")
    assert_match "{{name}}", out
  end
end
