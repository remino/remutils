#!/usr/bin/env bash
#
# rrrr - Reliable Recursive Redundant RSync
#
VERSION="1.3.0"

DEFAULT_FILTERS_CONTENT=$'- /dev/**\n- /proc/**\n- /sys/**\n- /run/**\n- /tmp/**\n- /mnt/**\n- /media/**\n- /lost+found\n- /swapfile'

declare -a RSYNC_FILTER_ARGS=()
declare -a RSYNC_VERBOSE_ARGS=()
declare -a RSYNC_ACL_ARGS=()
declare -a LINK_DEST_ARGS=()

# Cleanup --------------------------------------------------------------------

rrrr_cleanup() {
	local exit_status=$? tmp_file

	if [ -n "${SNAP_TMP_DIR:-}" ] && [ -d "${SNAP_TMP_DIR}" ]; then
		chmod -R u+w "${SNAP_TMP_DIR}" 2> /dev/null || true
		if ! rm -rf -- "${SNAP_TMP_DIR}"; then
			printf "%s\n" "rrrr: ERROR: could not remove incomplete snapshot: ${SNAP_TMP_DIR}" >&2
		fi
	fi

	if [ "${STORAGE_HOOK_ACTIVE:-0}" -eq 1 ]; then
		if ! rrrr_release_storage; then
			printf "%s\n" "rrrr: ERROR: storage unmount hook failed" >&2
		fi
		STORAGE_HOOK_ACTIVE=0
	fi

	for tmp_file in "${RETENTION_ALL_FILE}" "${RETENTION_KEEP_FILE}"; do
		if [ -n "${tmp_file}" ] && [ -f "${tmp_file}" ]; then
			rm -f "${tmp_file}"
		fi
	done

	if [ -n "${DEFAULT_FILTERS_FILE:-}" ] && [ -f "${DEFAULT_FILTERS_FILE}" ]; then
		rm -f "${DEFAULT_FILTERS_FILE}"
	fi

	return "${exit_status}"
}

# Shared helpers -------------------------------------------------------------

log() {
	local timestamp message
	timestamp="$(date '+%F %T')"
	message="[$timestamp] $*"

	if [ -n "${LOG_FILE:-}" ]; then
		printf "%s\n" "${message}" | tee -a "${LOG_FILE}"
	else
		printf "%s\n" "${message}"
	fi
}

die() {
	log "ERROR: $*"
	exit 1
}

require_cmd() {
	command -v "$1" > /dev/null 2>&1 || die "Missing required command: $1"
}

rrrr_main() {
	set -euo pipefail
	rrrr_reset_state
	trap rrrr_cleanup EXIT

	case "${1:-}" in
		backup)
			shift
			rrrr_backup "$@"
			;;
		mount)
			shift
			rrrr_mount "$@"
			;;
		unmount)
			shift
			rrrr_unmount "$@"
			;;
		help)
			rrrr_usage
			;;
		version)
			rrrr_print_version
			;;
		-h)
			rrrr_usage
			;;
		-v | -V)
			rrrr_print_version
			;;
		"")
			rrrr_usage >&2
			return 1
			;;
		*)
			# Compatibility with the original `rrrr <hostname>` invocation.
			rrrr_backup "$@"
			;;
	esac
}

rrrr_backup() {
	rrrr_load_host_config "$@"
	rrrr_prepare_filters "${HOST_CONFIG_DIR}"
	rrrr_validate_config
	rrrr_check_requirements
	rrrr_prepare_storage_for_backup
	rrrr_validate_storage
	rrrr_prepare_runtime

	rrrr_run_backup
}

rrrr_mount() {
	rrrr_load_host_config "$@"
	rrrr_has_managed_storage || die "No managed storage is configured for ${HOST_ARG}"

	if [ -f "${STORAGE_STATE_FILE}" ]; then
		rrrr_load_storage_state
		rrrr_storage_is_mounted || die "Recorded storage mount is no longer mounted: ${STORAGE_MOUNTPOINT}"
		log "Storage is already mounted: ${STORAGE_MOUNTPOINT}"
		return 0
	fi

	rrrr_prepare_storage
	rrrr_validate_storage
	[ -n "${STORAGE_MOUNTPOINT}" ] || die "STORAGE_MOUNTPOINT must be set to retain storage across commands"
	rrrr_write_storage_state
	STORAGE_HOOK_ACTIVE=0
	log "Storage mounted: ${STORAGE_MOUNTPOINT}"
}

rrrr_unmount() {
	rrrr_load_host_config "$@"
	[ -f "${STORAGE_STATE_FILE}" ] || die "No recorded storage mount for ${HOST_ARG}"

	rrrr_load_storage_state
	if ! rrrr_release_storage; then
		die "Could not unmount storage: ${STORAGE_MOUNTPOINT}"
	fi
	rm -f "${STORAGE_STATE_FILE}"
	log "Storage unmounted: ${STORAGE_MOUNTPOINT}"
}

rrrr_usage() {
	cat << 'USAGE'
Usage: rrrr <command> [arguments]

Reliable Recursive Redundant RSync backup runner.

Commands:
  backup <hostname>  Back up a configured host.
  mount <hostname>   Mount managed backup storage.
  unmount <hostname> Unmount storage mounted by rrrr.
  help               Show this help text.
  version            Print version.

<hostname> corresponds to a host-specific directory that lives in one of:
  $XDG_CONFIG_HOME/rrrr/<hostname>
  $XDG_CONFIG_DIRS/rrrr/<hostname> (searched in order)
  /etc/rrrr/<hostname>

Each directory must contain a "config" file that exports the variables needed
to reach the host (user, SSH key, backup root, etc). If a "filters" file is
present (or FILTERS_FILE points elsewhere) it will be merged into rsync using
--filter.

Compatibility aliases:
  -h    Show help text.
  -v    Print version.
USAGE
}

rrrr_print_version() {
	printf "rrrr %s\n" "${VERSION}"
}

# Per-run state --------------------------------------------------------------

rrrr_reset_state() {
	HOST_ARG=""
	HOST_CONFIG_DIR=""
	HOST_FILTER_FILE=""
	DATE_TODAY=""
	SNAP_DIR=""
	SNAP_TMP_DIR=""
	SNAPS_DIR=""
	PARTIALS_DIR=""
	LATEST_LINK=""
	LOG_DIR=""
	LOG_FILE=""
	SSH_CMD=""
	STORAGE_HOOK_ACTIVE=0
	STORAGE_PROVIDER=""
	STORAGE_IMAGE=""
	STORAGE_IMAGE_SIZE_MIB=""
	STORAGE_IMAGE_SIZE=""
	STORAGE_VOLUME_NAME=""
	STORAGE_MOUNTPOINT=""
	STORAGE_MOUNTPOINT_CREATED=0
	STORAGE_LOOP_DEVICE=""
	STORAGE_APFS_ATTACHED=0
	STORAGE_ELEVATE_USER=""
	STORAGE_STATE_FILE=""
	RETENTION_ALL_FILE=""
	RETENTION_KEEP_FILE=""
	DEFAULT_FILTERS_FILE=""

	rrrr_reset_config
}

rrrr_reset_config() {
	HOSTNAME_REMOTE=""
	REMOTE_USER=""
	REMOTE_SSH_HOST=""
	REMOTE_SSH_PORT=""
	SSH_KEY=""
	BACKUP_ROOT=""
	REMOTE_ROOT="/"
	RSYNC_VERBOSE="0"
	RSYNC_PRESERVE_ACLS="1"
	RSYNC_KEEP_PARTIAL="0"
	RSYNC_ACCEPT_PARTIAL="0"
	KEEP_DAILY=7
	KEEP_WEEKLY=4
	KEEP_MONTHLY=6
	FILTERS_FILE=""
}

# Configuration -------------------------------------------------------------

rrrr_find_host_config_dir() {
	local host="$1"
	local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
	local -a search_dirs=()
	local -a xdg_dirs=()
	local IFS=':'

	if [ -n "${XDG_CONFIG_DIRS:-}" ]; then
		read -r -a xdg_dirs <<< "${XDG_CONFIG_DIRS}"
	else
		xdg_dirs=("/etc/xdg")
	fi

	search_dirs+=("${config_home}")
	search_dirs+=("${xdg_dirs[@]}")

	for dir in "${search_dirs[@]}"; do
		[ -n "${dir}" ] || continue
		if [ -d "${dir}/rrrr/${host}" ]; then
			rrrr_abspath "${dir}/rrrr/${host}"
			return 0
		fi
	done

	if [ -d "/etc/rrrr/${host}" ]; then
		rrrr_abspath "/etc/rrrr/${host}"
		return 0
	fi

	return 1
}

rrrr_abspath() {
	local path="$1"

	if command -v realpath > /dev/null 2>&1; then
		if realpath "${path}"; then
			return 0
		fi
	fi

	if command -v python3 > /dev/null 2>&1; then
		python3 - "${path}" << 'PY'
import os
import sys
print(os.path.realpath(sys.argv[1]))
PY
		return 0
	fi

	if command -v perl > /dev/null 2>&1; then
		perl -MCwd=abs_path -e 'print abs_path(shift)' "${path}"
		return 0
	fi

	(
		cd "$(dirname "${path}")" > /dev/null 2>&1 || exit 1
		printf "%s/%s\n" "$(pwd)" "$(basename "${path}")"
	)
}

rrrr_source_host_config() {
	local dir="$1"
	local config_file="${dir}/config"

	[ -f "${config_file}" ] || die "Config file not found: ${config_file}"

	# shellcheck source=/dev/null
	source "${config_file}"
}

rrrr_load_host_config() {
	local host

	if [ "$#" -lt 1 ]; then
		rrrr_usage >&2
		return 1
	fi

	host="$1"
	HOST_ARG="${host}"
	[[ "${host}" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] || die "Hostname must be a single safe path component: ${host}"

	HOST_CONFIG_DIR="$(rrrr_find_host_config_dir "${host}")" || die "No host config directory found for ${host}"

	rrrr_reset_config
	rrrr_source_host_config "${HOST_CONFIG_DIR}"
	rrrr_set_derived_defaults
	rrrr_prepare_storage_state
}

rrrr_prepare_filters() {
	local dir="$1"
	local candidate=""

	if [ -f "${dir}/filters" ]; then
		candidate="${dir}/filters"
	elif [ -n "${FILTERS_FILE:-}" ]; then
		if [[ "${FILTERS_FILE}" = /* ]]; then
			candidate="${FILTERS_FILE}"
		else
			candidate="${dir}/${FILTERS_FILE}"
		fi
	fi

	if [ -n "${candidate}" ]; then
		[ -f "${candidate}" ] || die "Filters file not found: ${candidate}"
		HOST_FILTER_FILE="$(rrrr_abspath "${candidate}")"
	else
		HOST_FILTER_FILE="$(rrrr_create_default_filters_file)"
	fi
}

rrrr_create_default_filters_file() {
	require_cmd mktemp
	local tmp
	tmp="$(mktemp)"
	printf "%s\n" "${DEFAULT_FILTERS_CONTENT}" > "${tmp}"
	DEFAULT_FILTERS_FILE="${tmp}"
	printf "%s\n" "${DEFAULT_FILTERS_FILE}"
}

rrrr_set_derived_defaults() {
	HOSTNAME_REMOTE="${HOSTNAME_REMOTE:-${HOST_ARG}}"
	REMOTE_SSH_HOST="${REMOTE_SSH_HOST:-${HOST_ARG}}"
	REMOTE_ROOT="${REMOTE_ROOT:-/}"
}

rrrr_validate_config() {
	[ -n "${REMOTE_USER}" ] || die "REMOTE_USER must be set in host config"
	[ -n "${SSH_KEY}" ] || die "SSH_KEY must be set in host config"
	return 0
}

rrrr_prepare_storage() {
	case "${STORAGE_PROVIDER}" in
		"")
			if ! declare -F rrrr_storage_mount > /dev/null; then
				return 0
			fi

			declare -F rrrr_storage_unmount > /dev/null || die "rrrr_storage_unmount must be defined when rrrr_storage_mount is used"
			STORAGE_HOOK_ACTIVE=1
			log "Mounting backup storage..."
			rrrr_storage_mount
			;;
		ext4-image)
			if declare -F rrrr_storage_mount > /dev/null || declare -F rrrr_storage_unmount > /dev/null; then
				die "STORAGE_PROVIDER cannot be combined with custom storage hooks"
			fi

			STORAGE_HOOK_ACTIVE=1
			log "Mounting ext4 image storage..."
			rrrr_ext4_image_mount
			;;
		apfs-sparsebundle)
			if declare -F rrrr_storage_mount > /dev/null || declare -F rrrr_storage_unmount > /dev/null; then
				die "STORAGE_PROVIDER cannot be combined with custom storage hooks"
			fi

			STORAGE_HOOK_ACTIVE=1
			log "Mounting APFS sparse bundle storage..."
			rrrr_apfs_sparsebundle_mount
			;;
		*) die "Unsupported STORAGE_PROVIDER: ${STORAGE_PROVIDER}" ;;
	esac
}

# Storage providers ---------------------------------------------------------

rrrr_prepare_storage_state() {
	local state_home

	state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
	STORAGE_STATE_FILE="${state_home}/rrrr/${HOST_ARG}.storage"
}

rrrr_has_managed_storage() {
	[ -n "${STORAGE_PROVIDER}" ] || declare -F rrrr_storage_mount > /dev/null
}

rrrr_prepare_storage_for_backup() {
	if [ -f "${STORAGE_STATE_FILE}" ]; then
		rrrr_load_storage_state
		rrrr_storage_is_mounted || die "Recorded storage mount is no longer mounted: ${STORAGE_MOUNTPOINT}"
		log "Using manually mounted storage: ${STORAGE_MOUNTPOINT}"
		return 0
	fi

	rrrr_prepare_storage
}

rrrr_write_storage_state() {
	local state_dir state_tmp

	state_dir="$(dirname "${STORAGE_STATE_FILE}")"
	mkdir -p "${state_dir}"
	chmod 700 "${state_dir}"
	state_tmp="${STORAGE_STATE_FILE}.tmp.$$"

	(
		umask 077
		printf 'STORAGE_STATE_VERSION=%q\n' "1"
		printf 'STORAGE_STATE_PROVIDER=%q\n' "${STORAGE_PROVIDER}"
		printf 'BACKUP_ROOT=%q\n' "${BACKUP_ROOT}"
		printf 'STORAGE_MOUNTPOINT=%q\n' "${STORAGE_MOUNTPOINT}"
		printf 'STORAGE_MOUNTPOINT_CREATED=%q\n' "${STORAGE_MOUNTPOINT_CREATED}"
		printf 'STORAGE_LOOP_DEVICE=%q\n' "${STORAGE_LOOP_DEVICE}"
		printf 'STORAGE_APFS_ATTACHED=%q\n' "${STORAGE_APFS_ATTACHED}"
	) > "${state_tmp}"
	mv "${state_tmp}" "${STORAGE_STATE_FILE}"
}

rrrr_load_storage_state() {
	local expected_provider="${STORAGE_PROVIDER}"

	# shellcheck source=/dev/null
	source "${STORAGE_STATE_FILE}"
	[ "${STORAGE_STATE_VERSION:-}" = "1" ] || die "Unsupported storage state file: ${STORAGE_STATE_FILE}"
	[ "${STORAGE_STATE_PROVIDER:-}" = "${expected_provider}" ] || die "Storage state does not match the configured provider"
	STORAGE_PROVIDER="${expected_provider}"
}

rrrr_release_storage() {
	case "${STORAGE_PROVIDER}" in
		ext4-image) rrrr_ext4_image_unmount ;;
		apfs-sparsebundle) rrrr_apfs_sparsebundle_unmount ;;
		"") rrrr_storage_unmount ;;
		*) return 0 ;;
	esac
}

rrrr_validate_storage() {
	[ -n "${BACKUP_ROOT}" ] || die "BACKUP_ROOT must be set in host config"

	if [ "${STORAGE_HOOK_ACTIVE:-0}" -eq 1 ] && { [ ! -d "${BACKUP_ROOT}" ] || [ ! -w "${BACKUP_ROOT}" ]; }; then
		die "Storage mount hook did not provide a writable directory BACKUP_ROOT: ${BACKUP_ROOT}"
	fi
}

rrrr_prepare_runtime() {
	DATE_TODAY="$(date +%F)"
	SNAPS_DIR="${SNAPS_DIR:-${BACKUP_ROOT}/snapshots}"
	PARTIALS_DIR="${PARTIALS_DIR:-${BACKUP_ROOT}/partials}"
	SNAP_DIR="${SNAPS_DIR}/${DATE_TODAY}"
	LATEST_LINK="${LATEST_LINK:-${BACKUP_ROOT}/latest}"
	LOG_DIR="${LOG_DIR:-${BACKUP_ROOT}/logs}"
	LOG_FILE="${LOG_FILE:-${LOG_DIR}/${DATE_TODAY}.log}"

	mkdir -p "${SNAPS_DIR}" "${PARTIALS_DIR}" "${LOG_DIR}"
}

rrrr_check_requirements() {
	if [ "${BASH_VERSINFO[0]}" -lt 3 ]; then
		die "rrrr requires Bash 3 or newer"
	fi

	require_cmd rsync
	require_cmd ssh
	require_cmd basename
	require_cmd sort
	require_cmd head
	require_cmd tail
	require_cmd date
	require_cmd rm
	require_cmd ln
	require_cmd mkdir
	require_cmd mv
	require_cmd readlink
	require_cmd awk
	require_cmd grep
	require_cmd mktemp

	if ! rrrr_weekday "2000-01-02" > /dev/null; then
		die "rrrr requires date with GNU (-d) or BSD (-j -f) date parsing support"
	fi

	[ -f "${SSH_KEY}" ] || die "SSH key not found: ${SSH_KEY}"

	if [ -n "${HOST_FILTER_FILE}" ] && [ ! -f "${HOST_FILTER_FILE}" ]; then
		die "Filter file not found: ${HOST_FILTER_FILE}"
	fi
}

rrrr_ext4_image_mount() {
	require_cmd dd
	require_cmd dirname
	require_cmd losetup
	require_cmd mkfs.ext4
	require_cmd mount
	require_cmd rmdir
	require_cmd umount
	if [ -n "${STORAGE_ELEVATE_USER}" ]; then
		require_cmd chown
		require_cmd id
		require_cmd sudo
	fi

	[ -n "${STORAGE_IMAGE}" ] || die "STORAGE_IMAGE must be set when STORAGE_PROVIDER=ext4-image"

	if [ ! -f "${STORAGE_IMAGE}" ]; then
		case "${STORAGE_IMAGE_SIZE_MIB}" in
			"" | *[!0-9]*) die "STORAGE_IMAGE_SIZE_MIB must be a positive integer when creating an image" ;;
		esac
		[ "${STORAGE_IMAGE_SIZE_MIB}" -gt 0 ] || die "STORAGE_IMAGE_SIZE_MIB must be greater than zero"

		mkdir -p "$(dirname "${STORAGE_IMAGE}")"
		log "Creating ext4 image: ${STORAGE_IMAGE} (${STORAGE_IMAGE_SIZE_MIB} MiB)"
		rrrr_storage_privileged dd if=/dev/zero of="${STORAGE_IMAGE}" bs=1M count="${STORAGE_IMAGE_SIZE_MIB}"
		rrrr_storage_privileged mkfs.ext4 -F -O ^metadata_csum_seed "${STORAGE_IMAGE}"
	fi

	if [ -z "${STORAGE_MOUNTPOINT}" ]; then
		STORAGE_MOUNTPOINT="${TMPDIR:-/tmp}/rrrr-${HOST_ARG}-$$"
		STORAGE_MOUNTPOINT_CREATED=1
	fi
	mkdir -p "${STORAGE_MOUNTPOINT}"

	STORAGE_LOOP_DEVICE="$(rrrr_storage_privileged losetup -f)"
	[ -n "${STORAGE_LOOP_DEVICE}" ] || die "No free loop device available"
	rrrr_storage_privileged losetup "${STORAGE_LOOP_DEVICE}" "${STORAGE_IMAGE}"
	rrrr_storage_privileged mount -t ext4 "${STORAGE_LOOP_DEVICE}" "${STORAGE_MOUNTPOINT}"
	if [ -n "${STORAGE_ELEVATE_USER}" ]; then
		rrrr_storage_privileged chown "$(id -u):$(id -g)" "${STORAGE_MOUNTPOINT}"
	fi
	BACKUP_ROOT="${STORAGE_MOUNTPOINT}"
}

rrrr_storage_privileged() {
	if [ -n "${STORAGE_ELEVATE_USER}" ]; then
		sudo -n -u "${STORAGE_ELEVATE_USER}" "$@"
	else
		"$@"
	fi
}

rrrr_ext4_image_unmount() {
	local status=0

	if [ -n "${STORAGE_MOUNTPOINT}" ] && rrrr_storage_is_mounted; then
		if ! rrrr_storage_privileged umount "${STORAGE_MOUNTPOINT}"; then
			status=1
		fi
	fi

	if [ "${status}" -eq 0 ] && [ -n "${STORAGE_LOOP_DEVICE}" ]; then
		if ! rrrr_storage_privileged losetup -d "${STORAGE_LOOP_DEVICE}"; then
			status=1
		fi
		STORAGE_LOOP_DEVICE=""
	fi

	if [ "${STORAGE_MOUNTPOINT_CREATED}" -eq 1 ] && [ -d "${STORAGE_MOUNTPOINT}" ]; then
		rmdir "${STORAGE_MOUNTPOINT}" || status=1
	fi

	return "${status}"
}

rrrr_apfs_sparsebundle_mount() {
	local attach_output

	require_cmd awk
	require_cmd dirname
	require_cmd hdiutil
	require_cmd rmdir

	[ -n "${STORAGE_IMAGE}" ] || die "STORAGE_IMAGE must be set when STORAGE_PROVIDER=apfs-sparsebundle"
	STORAGE_VOLUME_NAME="${STORAGE_VOLUME_NAME:-rrrr-${HOST_ARG}}"

	if [ ! -e "${STORAGE_IMAGE}" ]; then
		[ -n "${STORAGE_IMAGE_SIZE}" ] || die "STORAGE_IMAGE_SIZE must be set when creating an APFS sparse bundle"

		mkdir -p "$(dirname "${STORAGE_IMAGE}")"
		log "Creating APFS sparse bundle: ${STORAGE_IMAGE} (${STORAGE_IMAGE_SIZE})"
		hdiutil create -size "${STORAGE_IMAGE_SIZE}" -type SPARSEBUNDLE -fs APFS -volname "${STORAGE_VOLUME_NAME}" "${STORAGE_IMAGE}"
	elif [ ! -d "${STORAGE_IMAGE}" ]; then
		die "STORAGE_IMAGE must be an APFS sparse bundle directory: ${STORAGE_IMAGE}"
	fi

	if [ -z "${STORAGE_MOUNTPOINT}" ]; then
		attach_output="$(hdiutil attach "${STORAGE_IMAGE}" -nobrowse)"
		STORAGE_MOUNTPOINT="$(printf '%s\n' "${attach_output}" | awk -F '\t' 'NF >= 3 && $NF ~ /^\// { print $NF; exit }')"
		[ -n "${STORAGE_MOUNTPOINT}" ] || die "Could not determine the APFS mountpoint"
	else
		mkdir -p "${STORAGE_MOUNTPOINT}"
		hdiutil attach "${STORAGE_IMAGE}" -nobrowse -mountpoint "${STORAGE_MOUNTPOINT}"
	fi
	STORAGE_APFS_ATTACHED=1
	BACKUP_ROOT="${STORAGE_MOUNTPOINT}"
}

rrrr_apfs_sparsebundle_unmount() {
	local status=0

	if [ "${STORAGE_APFS_ATTACHED}" -eq 1 ]; then
		if ! hdiutil detach "${STORAGE_MOUNTPOINT}"; then
			status=1
		fi
		STORAGE_APFS_ATTACHED=0
	fi

	if [ "${STORAGE_MOUNTPOINT_CREATED}" -eq 1 ] && [ -d "${STORAGE_MOUNTPOINT}" ]; then
		rmdir "${STORAGE_MOUNTPOINT}" || status=1
	fi

	return "${status}"
}

rrrr_storage_is_mounted() {
	mount | awk -v mountpoint="${STORAGE_MOUNTPOINT}" '$3 == mountpoint { found = 1 } END { exit !found }'
}

# Backup pipeline -----------------------------------------------------------

rrrr_run_backup() {
	log "=== Backup start (${HOSTNAME_REMOTE}) ==="
	log "Backup root: ${BACKUP_ROOT}"
	log "Snapshot dir: ${SNAP_DIR}"

	rrrr_prepare_snapshot_dir
	rrrr_build_link_dest_args
	rrrr_build_filter_args
	rrrr_build_rsync_verbose_args
	rrrr_build_rsync_acl_args
	rrrr_build_ssh_command

	local rsync_status=0
	rrrr_run_rsync || rsync_status=$?
	if [ "${rsync_status}" -eq 23 ] && [ "${RSYNC_ACCEPT_PARTIAL}" = "1" ]; then
		log "Accepting rsync exit 23 with unreadable paths."
		rrrr_publish_snapshot
		rrrr_update_latest
		rrrr_apply_retention
		log "=== Backup complete with unreadable paths (${HOSTNAME_REMOTE}) ==="
		return 0
	fi
	if [ "${rsync_status}" -eq 23 ] && [ "${RSYNC_KEEP_PARTIAL}" = "1" ]; then
		rrrr_publish_partial_snapshot
		log "=== Partial backup retained (${HOSTNAME_REMOTE}); rsync exit status: ${rsync_status} ==="
		return "${rsync_status}"
	fi
	[ "${rsync_status}" -eq 0 ] || return "${rsync_status}"

	rrrr_publish_snapshot
	rrrr_update_latest
	rrrr_apply_retention

	log "=== Backup complete (${HOSTNAME_REMOTE}) ==="
}

rrrr_prepare_snapshot_dir() {
	if [ -e "${SNAP_DIR}" ]; then
		die "Snapshot already exists for today: ${SNAP_DIR}"
	fi

	SNAP_TMP_DIR="${SNAPS_DIR}/.${DATE_TODAY}.incomplete.$$"
	if [ -e "${SNAP_TMP_DIR}" ]; then
		die "Temporary snapshot directory already exists: ${SNAP_TMP_DIR}"
	fi

	mkdir -p "${SNAP_TMP_DIR}"
}

rrrr_build_link_dest_args() {
	LINK_DEST_ARGS=()

	if [ -L "${LATEST_LINK}" ]; then
		local prev
		prev="$(rrrr_resolve_link_target "${LATEST_LINK}")"
		if [ -n "${prev}" ] && [ -d "${prev}" ]; then
			log "Using --link-dest from previous snapshot: ${prev}"
			LINK_DEST_ARGS=(--link-dest "${prev}")
		else
			log "latest symlink exists but target is invalid; ignoring --link-dest"
		fi
	else
		log "No previous snapshot found (no latest symlink). Full copy run."
	fi
}

rrrr_resolve_link_target() {
	local link="$1"
	local target

	target="$(readlink "${link}")" || return 1

	if [[ "${target}" = /* ]]; then
		printf "%s\n" "${target}"
	else
		(
			cd "$(dirname "${link}")" > /dev/null 2>&1 || exit 1
			printf "%s/%s\n" "$(pwd)" "${target}"
		)
	fi
}

rrrr_weekday() {
	local snapshot_date="$1"

	if date -d "${snapshot_date}" +%u > /dev/null 2>&1; then
		date -d "${snapshot_date}" +%u
		return 0
	fi

	date -j -f "%F" "${snapshot_date}" +%u
}

rrrr_build_filter_args() {
	RSYNC_FILTER_ARGS=()
	if [ -n "${HOST_FILTER_FILE}" ]; then
		RSYNC_FILTER_ARGS+=(--filter="merge ${HOST_FILTER_FILE}")
	fi
}

rrrr_build_rsync_verbose_args() {
	RSYNC_VERBOSE_ARGS=()

	case "${RSYNC_VERBOSE}" in
		"" | 0) ;;
		1) RSYNC_VERBOSE_ARGS=(-v) ;;
		2) RSYNC_VERBOSE_ARGS=(-vv) ;;
		3) RSYNC_VERBOSE_ARGS=(-vvv) ;;
		*) die "RSYNC_VERBOSE must be 0, 1, 2, or 3" ;;
	esac
}

rrrr_build_rsync_acl_args() {
	RSYNC_ACL_ARGS=()

	case "${RSYNC_PRESERVE_ACLS}" in
		0) ;;
		1) RSYNC_ACL_ARGS=(-A) ;;
		*) die "RSYNC_PRESERVE_ACLS must be 0 or 1" ;;
	esac

	case "${RSYNC_KEEP_PARTIAL}" in
		0 | 1) ;;
		*) die "RSYNC_KEEP_PARTIAL must be 0 or 1" ;;
	esac

	case "${RSYNC_ACCEPT_PARTIAL}" in
		0 | 1) ;;
		*) die "RSYNC_ACCEPT_PARTIAL must be 0 or 1" ;;
	esac
}

rrrr_build_ssh_command() {
	SSH_CMD="ssh"
	if [ -n "${REMOTE_SSH_PORT}" ]; then
		SSH_CMD+=" -p ${REMOTE_SSH_PORT}"
	fi
	SSH_CMD+=" -i ${SSH_KEY} -o BatchMode=no -o StrictHostKeyChecking=accept-new"
}

rrrr_run_rsync() {
	local status=0

	log "Running rsync..."
	log "Remote: ${REMOTE_USER}@${REMOTE_SSH_HOST}:${REMOTE_ROOT}"
	log "Log: ${LOG_FILE}"

	if rsync -aHX "${RSYNC_ACL_ARGS[@]}" "${RSYNC_VERBOSE_ARGS[@]}" --numeric-ids --delete \
		--info=stats2,progress2 \
		"${RSYNC_FILTER_ARGS[@]}" \
		"${LINK_DEST_ARGS[@]}" \
		-e "${SSH_CMD}" \
		"${REMOTE_USER}@${REMOTE_SSH_HOST}:${REMOTE_ROOT}" \
		"${SNAP_TMP_DIR}/" \
		2>&1 | tee -a "${LOG_FILE}"; then
		log "rsync finished."
		return 0
	else
		status=$?
	fi

	return "${status}"
}

rrrr_publish_snapshot() {
	mv "${SNAP_TMP_DIR}" "${SNAP_DIR}"
	SNAP_TMP_DIR=""
	log "Published snapshot: ${SNAP_DIR}"
}

rrrr_publish_partial_snapshot() {
	local partial_dir="${PARTIALS_DIR}/${DATE_TODAY}.partial.$$"

	mv "${SNAP_TMP_DIR}" "${partial_dir}"
	SNAP_TMP_DIR=""
	log "Retained partial snapshot: ${partial_dir}"
}

rrrr_update_latest() {
	rm -f "${LATEST_LINK}"
	ln -s "${SNAP_DIR}" "${LATEST_LINK}"
	log "Updated latest -> ${SNAP_DIR}"
}

rrrr_apply_retention() {
	log "Applying retention: daily=${KEEP_DAILY}, weekly=${KEEP_WEEKLY}, monthly=${KEEP_MONTHLY}"

	local snapshot_path d deleted=0
	RETENTION_ALL_FILE="$(mktemp)"
	RETENTION_KEEP_FILE="$(mktemp)"

	{
		for snapshot_path in "${SNAPS_DIR}"/*; do
			[ -d "${snapshot_path}" ] || continue
			basename "${snapshot_path}"
		done
	} | sort > "${RETENTION_ALL_FILE}"

	if [ ! -s "${RETENTION_ALL_FILE}" ]; then
		log "No snapshots found. Skipping retention."
		return
	fi

	if [ "${KEEP_DAILY}" -gt 0 ]; then
		tail -n "${KEEP_DAILY}" "${RETENTION_ALL_FILE}" >> "${RETENTION_KEEP_FILE}"
	fi

	if [ "${KEEP_WEEKLY}" -gt 0 ]; then
		while IFS= read -r d; do
			if [ "$(rrrr_weekday "${d}" 2> /dev/null || echo "0")" = "7" ]; then
				printf "%s\n" "${d}"
			fi
		done < "${RETENTION_ALL_FILE}" | tail -n "${KEEP_WEEKLY}" >> "${RETENTION_KEEP_FILE}"
	fi

	if [ "${KEEP_MONTHLY}" -gt 0 ]; then
		awk -F- '$3=="01"{print $0}' "${RETENTION_ALL_FILE}" | tail -n "${KEEP_MONTHLY}" >> "${RETENTION_KEEP_FILE}"
	fi

	sort -u "${RETENTION_KEEP_FILE}" -o "${RETENTION_KEEP_FILE}"
	while IFS= read -r d; do
		if grep -Fx -- "${d}" "${RETENTION_KEEP_FILE}" > /dev/null; then
			log "Keep: ${d}"
		else
			log "Delete: ${d}"
			rm -rf -- "${SNAPS_DIR:?}/${d}"
			deleted=$((deleted + 1))
		fi
	done < "${RETENTION_ALL_FILE}"

	rm -f "${RETENTION_ALL_FILE}" "${RETENTION_KEEP_FILE}"
	RETENTION_ALL_FILE=""
	RETENTION_KEEP_FILE=""

	log "Retention done. Deleted ${deleted} snapshots."
}

rrrr_main "$@"
