# vim: set ft=ruby :
class {{formula_class}} < Formula
  desc "Generate cryptographically random strings"
  version "{{version}}"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils/tree/main/genrand"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on "bash"

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "genrand"
    man1.install "man/genrand.1"
  end

  test do
    assert_match /^[a-z0-9]{8}$/, shell_output("#{bin}/genrand 8 lower").strip
  end
end
