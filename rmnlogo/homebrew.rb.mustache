# vim: set ft=ruby :
class {{formula_class}} < Formula
  desc "Outputs the RÉMINO logo in ASCII art and ANSI colours."
  version "{{version}}"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils/tree/main/rmnlogo"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on "bash"

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "rmnlogo"
    man1.install "man/rmnlogo.1"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rmnlogo -v")
  end
end
