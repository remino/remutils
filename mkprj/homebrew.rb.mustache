# vim: set ft=ruby :
class {{formula_class}} < Formula
  desc "Create dated project directories from optional templates."
  version "{{version}}"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on "bash"

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "{{name}}"
    libexec.install "lib", "templates"
    man1.install "man/{{name}}.1"
  end

  test do
    system "#{bin}/{{name}}", "-v"
  end
end
