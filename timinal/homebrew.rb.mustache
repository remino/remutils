# vim: set ft=ruby :
class {{formula_class}} < Formula
  include Language::Python::Virtualenv

  desc "Render a configurable FIGlet clock"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils/tree/main/timinal"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on "figlet"
  depends_on "python@3.14"

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    virtualenv_install_with_resources
    man1.install "man/timinal.1"
  end

  test do
    system bin/"timinal", "--format", "%H:%M"
  end
end
