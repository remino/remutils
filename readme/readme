#!/usr/bin/env bash
# Open or list README files near the current directory.

set -euo pipefail

VERSION=0.2.0

usage() {
	printf '%s\n' \
		"readme $VERSION" \
		'' \
		'USAGE: readme [-hlv] [<filename>]' \
		'' \
		'Open the nearest README file in the current directory or its immediate child' \
		'directories.' \
		'' \
		'OPTIONS:' \
		'  -h    Show this help screen.' \
		'  -l    List matching README files instead of opening one.' \
		'  -v    Show the version number.' \
		'' \
		'ARGUMENTS:' \
		'  filename    File to open, or directory whose README to open.'
}

version() {
	printf 'readme %s\n' "$VERSION"
}

error() {
	printf 'readme: %s\n' "$*" >&2
}

find_readmes() {
	local directory="${1:-.}"
	local -a find_args

	find_args=(-type f \( -iname 'readme' -o -iname 'readme.*' \))

	find "$directory" -maxdepth 1 "${find_args[@]}" -print | sort -f
}

main() {
	local list=false filename='' readmefile readmes

	while getopts ':hlv' option; do
		case "$option" in
			h)
				usage
				return
				;;
			l) list=true ;;
			v)
				version
				return
				;;
			:)
				error "option -$OPTARG requires an argument"
				usage >&2
				return 16
				;;
			?)
				error "invalid option: -$OPTARG"
				usage >&2
				return 16
				;;
		esac
	done
	shift "$((OPTIND - 1))"

	if (($# > 1)); then
		error 'accepts at most one filename'
		usage >&2
		return 16
	fi
	(($#)) && filename="$1"

	if [[ -n "$filename" ]]; then
		if [[ -f "$filename" ]]; then
			readmefile="$filename"
		elif [[ -d "$filename" ]]; then
			readmes="$(find_readmes "$filename")"
			readmefile="${readmes%%$'\n'*}"
			if [[ -z "$readmefile" ]]; then
				error "no matching README file found in: $filename"
				return 1
			fi
		else
			error "not a file or directory: $filename"
			return 1
		fi

		if "$list"; then
			printf '%s\n' "$readmefile"
			return
		fi

	else
		if "$list"; then
			# Prefer this directory's README, then list immediate child directories.
			find_readmes
			find . -mindepth 2 -maxdepth 2 -type f \( -iname 'readme' -o -iname 'readme.*' \) -print | sort -f
			return
		fi

		readmes="$(
			find_readmes
			find . -mindepth 2 -maxdepth 2 -type f \( -iname 'readme' -o -iname 'readme.*' \) -print | sort -f
		)"
		readmefile="${readmes%%$'\n'*}"
		if [[ -z "$readmefile" ]]; then
			error 'no matching README file found'
			return 1
		fi
	fi

	if command -v glow > /dev/null 2>&1; then
		glow -p "$readmefile"
	else
		less "$readmefile"
	fi
}

main "$@"
