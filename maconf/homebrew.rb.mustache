# vim: set ft=ruby :
class {{formula_class}} < Formula
  desc "Get and set common macOS preferences"
  url "https://github.com/remino/remutils/releases/download/{{tag}}/{{tag}}.tar.gz"
  sha256 "{{sha256}}"
  license "ISC"
  homepage "https://github.com/remino/remutils/tree/main/{{name}}"
  {{#revision}}
  revision {{revision}}
  {{/revision}}

  depends_on :macos

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    bin.install "{{name}}"
    man1.install "man/{{name}}.1"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/{{name}} -v")
  end
end
